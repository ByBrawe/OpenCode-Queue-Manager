{
  "name": "@bybrawe/opencode-queue-manager",
  "version": "0.3.4",
  "description": "OpenCode queue manager for Desktop & TUI: batch prompts, editable drafts, repeat 100/200 messages, install/uninstall CLI.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/ByBrawe/OpenCode-Queue-Manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ByBrawe/OpenCode-Queue-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/ByBrawe/OpenCode-Queue-Manager/issues"
  },
  "keywords": [
    "opencode",
    "opencode-v2",
    "opencode-plugin",
    "opencode-queue",
    "queue-manager",
    "ai-coding-agent",
    "prompt-queue",
    "batch-prompts",
    "desktop",
    "tui",
    "deepseek",
    "windows",
    "macos",
    "linux"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.mjs",
    "./tui": "./src/tui.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "scripts": {
    "build": "node scripts/build-gui.mjs",
    "check": "node --check dist/gui-experimental.cjs && node --check src/gui-experimental.mjs && node --check src/queue-core.mjs && node --check src/installer/jsonc-config.mjs && node --check src/installer/cli.mjs && node --check bin/opencode-queue-manager.mjs && node --check scripts/prepare-npm-release.mjs && node --check src/release/version.mjs",
    "test": "node --test",
    "verify": "npm run build && npm run check && npm test",
    "prepack": "npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "opencode-queue-manager": "./bin/opencode-queue-manager.mjs"
  },
  "releaseCommit": "bcc2183097f39bbc0c8b6f119ced7b4a9148eeaa",
  "devDependencies": {
    "solid-js": "^1.9.12",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.0"
  }
}
